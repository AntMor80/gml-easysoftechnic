# Copia este archivo como .env junto al servidor (o pon estas variables en el panel de Hostinger).
# No subas nunca el .env a GitHub.

PORT=3000
PUBLIC_URL=https://app.easysoftechnic.com

# Cadena larga y aleatoria (al menos 32 caracteres). Si la cambias, se cierran todas las sesiones.
JWT_SECRET=

# Base de datos MySQL creada en hPanel > Bases de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Stripe (Panel de Stripe > Desarrolladores > Claves de API y Webhooks)
# Webhook: https://app.easysoftechnic.com/api/stripe/webhook con el evento checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo para recuperar contraseñas y enviar licencias (buzón de Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GML EasySoftechnic <no-responder@easysoftechnic.com>"

# Firma de licencias: genérala con  npm run keys -w @gml/server
LICENSE_PRIVATE_KEY=

# Correos con acceso a Administración en Mi cuenta (separados por comas)
ADMIN_EMAILS=

# Créditos de regalo al crear la cuenta
WELCOME_CREDITS=3
