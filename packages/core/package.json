{
  "name": "@gml/core",
  "version": "0.1.0",
  "description": "Motor común: lectura, validación, transformación y escritura de GML catastrales",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.0.3",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "pdfmake": "^0.2.15",
    "proj4": "^2.15.0"
  },
  "devDependencies": {
    "@types/pdfmake": "^0.2.11",
    "@types/proj4": "^2.5.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
